# Environment Variables

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Supabase)
DATABASE_URL=
DIRECT_URL=

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Integration (OAuth & APIs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENCRYPTION_KEY= # Random 32-character string for encrypting OAuth tokens

# AI
GEMINI_API_KEY= # Replaces Anthropic

# Cron Secret
CRON_SECRET= # Secret key for manual/cron execution of the agent
